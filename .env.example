# Flare Monitor Environment Variables
# Copy this file to .env and fill in your values

# Flare Network RPC Configuration
# Primary RPC endpoint for Flare network
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# Optional: Fallback RPC endpoints (comma-separated)
# FLARE_RPC_FALLBACK=https://flare.public-rpc.com,https://flare-rpc.ftso.au

# Optional: RPC API Key (if using a private RPC provider)
# FLARE_RPC_API_KEY=your_api_key_here

# Application Settings
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Polling interval in seconds (how often to fetch prices)
POLL_INTERVAL=2

# Spread alert threshold percentage (only alert on spreads above this)
SPREAD_ALERT_THRESHOLD=5.0

# Maximum number of concurrent RPC requests
MAX_CONCURRENT_REQUESTS=10

# Optional: Configuration file path override
# CONFIG_PATH=config/config.yaml

# Optional: Enable debug mode for asyncio
# ASYNCIO_DEBUG=false
